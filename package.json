{
  "name": "@luminix/mui-cms",
  "version": "",
  "type": "module",
  "main": "bundle/mui-cms.js",
  "module": "dist/mui-cms.js",
  "types": "types/index.d.ts",
  "scripts": {
    "dev": "vite --port=3333 --config=vite.config.dev.ts",
    "build": "npm run build:bundle && npm run build:dist",
    "build:bundle": "tsc && vite build --config vite.config.bundle.ts",
    "build:dist": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "publish:beta": "npm run build && npm publish --tag beta"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.0.12",
    "@luminix/core": "^1.0.0",
    "@luminix/react": "^1.0.0",
    "@luminix/support": "^1.0.1",
    "@mui/icons-material": "^5.16.5",
    "@mui/material": "^5.16.5",
    "i18next": "^23.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-router-dom": "6.25.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^29.1.1",
    "terser": "^5.31.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.0.3",
    "vitest": "^4.1.6"
  }
}
